generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id              String   @id @default(cuid())
  title           String
  description     String
  longDescription String?
  tags            String[]
  status          String   @default("planning")
  startDate       String
  endDate         String?
  featured        Boolean  @default(false)
  githubUrl       String?
  liveUrl         String?
  demoUrl         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Block {
  id        String   @id @default(cuid())
  tag       String
  date      String
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id           String   @id
  mainPhoto    String   @default("/me/aquarium.jpg")
  photoCaption String   @default("Japan, 2024")
  name         String
  title        String
  description  String
  university   String
  degree       String
  location     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SkillGroup {
  id        String   @id @default(cuid())
  category  String
  items     String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Experience {
  id        String   @id @default(cuid())
  year      String
  role      String
  company   String
  desc      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Photo {
  id          String   @id @default(cuid())
  src         String
  alt         String   @default("")
  caption     String   @default("")
  inSlideshow Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String   @default("Admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
