generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id              String   @id @default(cuid())
  title           String
  description     String
  longDescription String?
  tags            String[]
  status          String   @default("planning")
  startDate       String
  endDate         String?
  featured        Boolean  @default(false)
  githubUrl       String?
  liveUrl         String?
  demoUrl         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Block {
  id        String   @id @default(cuid())
  tag       String
  date      String
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
